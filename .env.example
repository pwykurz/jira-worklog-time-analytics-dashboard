# Copy this file to .env and fill in the blanks. NEVER commit .env.
# `.env` is listed in .gitignore; only this example file belongs in the repository.

# --- Atlassian OAuth 2.0 (3LO) ----------------------------------------------
# Create an OAuth 2.0 integration at https://developer.atlassian.com/console/myapps/
# and copy the Client ID / Secret from its Settings page.
# (ATLASSIAN_CLIENT_ID / ATLASSIAN_CLIENT_SECRET are accepted as aliases.)
CLIENT_ID=
SECRET=

# Random secret used to encrypt server-side sessions (NOT issued by Atlassian).
# Generate one with: openssl rand -hex 32
# Changing it later invalidates every existing session.
SESSION_SECRET=

# --- URLs and ports ---------------------------------------------------------
# Public URL of the web app, without a trailing slash. The OAuth callback is
# {APP_URL}/api/auth/jira/callback and must be registered in the Atlassian console.
# Development: http://localhost:3000   Production: https://reports.example.com
APP_URL=http://localhost:3000

# Express API port (the Vite dev server proxies /api to it).
PORT=3001

# Express API bind address. Loopback by default; use 0.0.0.0 only if you
# understand the exposure (normally a reverse proxy on the same host is enough).
# HOST=127.0.0.1

# Base path of the API as seen by the browser. Baked into the bundle at build time.
VITE_API_BASE_URL="/api"

# --- Optional ---------------------------------------------------------------
# Preferred Jira Cloud site when the Atlassian account has access to several.
JIRA_BASE_URL=https://your-site.atlassian.net

# true = the worklog endpoint also returns issues without worklogs (as zero-time rows).
JIRA_INCLUDE_ISSUES_WITHOUT_WORKLOGS=false
