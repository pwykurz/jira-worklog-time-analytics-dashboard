{
  "name": "jira-worklog-time-analytics-dashboard",
  "private": true,
  "version": "2.0.0",
  "description": "Self-hosted dashboard that turns Jira Cloud worklogs into time analytics, scoped reports and client-ready PDFs.",
  "license": "MIT",
  "author": "Paweł Wykurz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pwykurz/jira-worklog-time-analytics-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/pwykurz/jira-worklog-time-analytics-dashboard/issues"
  },
  "homepage": "https://github.com/pwykurz/jira-worklog-time-analytics-dashboard#readme",
  "keywords": [
    "jira",
    "worklog",
    "time-tracking",
    "analytics",
    "dashboard",
    "reporting",
    "react",
    "express"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port=3000",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "tsx watch server/index.ts & vite --port=3000",
    "start": "tsx server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.55.0",
    "pdfmake": "^0.3.11",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
